# The briq sandbox, `full`: everything in the default image, plus document and media tools, the
# Python data libraries, and Playwright with a Chromium of its own. A few gigabytes instead of
# under one; pick it with `image: "ghcr.io/briq-cloud/sandbox:full"` when the task needs it.
ARG BASE=ghcr.io/briq-cloud/sandbox:latest
FROM ${BASE}

ARG DEBIAN_FRONTEND=noninteractive

# Documents, images, audio and video, OCR, graphs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    pandoc poppler-utils qpdf \
    ffmpeg imagemagick \
    tesseract-ocr tesseract-ocr-eng \
    graphviz \
  && rm -rf /var/lib/apt/lists/*

# The Python data and document libraries, for `python` (3.13).
RUN python -m pip install --no-cache-dir \
    numpy pandas matplotlib openpyxl python-docx python-pptx pypdf requests

# Playwright for Python and Node.js on the same minor (their patch numbers differ; the browser
# build is per minor), with the Chromium they expect. Both find it through
# PLAYWRIGHT_BROWSERS_PATH, so no `playwright install` is needed.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
RUN python -m pip install --no-cache-dir playwright \
  && PW="$(python -c 'import importlib.metadata as m; print(".".join(m.version("playwright").split(".")[:2]))')" \
  && npm install -g --no-fund --no-audit "playwright@${PW}" \
  && playwright install --with-deps chromium \
  && python -m playwright install chromium \
  && npm cache clean --force \
  && rm -rf /var/lib/apt/lists/*
