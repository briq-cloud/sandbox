# CPU-only CAD, mesh conversion and rendering, on the default development image.
ARG BASE=ghcr.io/briq-cloud/sandbox:latest
FROM ${BASE}
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    blender openscad ffmpeg libgl1 libglu1-mesa \
  && rm -rf /var/lib/apt/lists/*
# CadQuery's wheels support Python 3.12. Keep its dependencies apart from default Python.
RUN uv venv --python python3.12 /opt/cad \
  && uv pip install --python /opt/cad/bin/python --no-cache \
    cadquery trimesh ezdxf Pillow numpy \
  && ln -s /opt/cad/bin/python /usr/local/bin/cad-python
# FreeCAD is absent from Ubuntu 24.04's repositories. Use a stable conda-forge
# release and its matching Python instead of mixing distro and uv extension ABIs.
COPY --from=mambaorg/micromamba:2.3.3 /bin/micromamba /usr/local/bin/micromamba
RUN MAMBA_ROOT_PREFIX=/opt/mamba micromamba create --yes --prefix /opt/freecad \
    --override-channels --channel conda-forge 'freecad=1.1.3' 'python=3.12' \
  && MAMBA_ROOT_PREFIX=/opt/mamba micromamba clean --all --yes
COPY bin/freecad-python /usr/local/bin/freecad-python
COPY bin/sandbox-versions /usr/local/bin/sandbox-versions
COPY examples/3d /opt/3d/examples
COPY tests/3d-smoke.sh /opt/3d/smoke.sh
