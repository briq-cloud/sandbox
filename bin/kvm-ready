#!/bin/sh
# Makes a kvm sandbox ready for a hypervisor, at each boot (the kvm-sandbox recipe runs it before
# its steps). The guest's own init starts no udev and loads no module, so:
# - udev, for the /dev/zvol/* and /dev/disk/* links ZFS and disk tools look for;
# - the ZFS module, from the modules the host's kvm kernel brings at /lib/modules/<release>;
# - every cgroup v2 controller delegated to the children (a jailer puts each VM in its own).
# Safe to run again.
set -eu

[ -e /dev/kvm ] || { echo "kvm-ready: no /dev/kvm: this briq was not made with kvm: true" >&2; exit 1; }

if ! pgrep -x systemd-udevd > /dev/null; then /usr/lib/systemd/systemd-udevd --daemon; fi
udevadm trigger --action=add
udevadm settle --timeout=30

release=$(uname -r)
if [ -d "/lib/modules/$release" ]; then
  modprobe zfs
else
  echo "kvm-ready: no modules for kernel $release: ZFS is not available" >&2
fi

for c in $(cat /sys/fs/cgroup/cgroup.controllers); do
  grep -qw "$c" /sys/fs/cgroup/cgroup.subtree_control || echo "+$c" > /sys/fs/cgroup/cgroup.subtree_control
done

zfs=$(cat /sys/module/zfs/version 2>/dev/null || echo none)
echo "kvm-ready: /dev/kvm, kernel $release, zfs module $zfs, cgroup controllers: $(cat /sys/fs/cgroup/cgroup.subtree_control)"
